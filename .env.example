# Zawer 根目录统一配置模板
# 本地演示时请复制为 .env.local 并填写实际值

# ------------------------
# 前端配置（Vite）
# ------------------------
# 本地开发推荐使用 Vite 代理，不直接写死后端地址
VITE_API_BASE_URL=/api

# 高德地图 JS API Key（在 https://lbs.amap.com/ 申请）
VITE_AMAP_KEY=your_amap_key_here

# 高德地图 JS API Secret
VITE_AMAP_SECRET=your_amap_secret_here

# 应用标题
VITE_APP_TITLE=Zawer - 附近 Zawer 地图

# ------------------------
# 后端配置（NestJS）
# ------------------------
# 后端服务端口，避免与前端 3000 端口冲突
SERVER_PORT=4000

# 前端本地访问地址，用于 CORS
FRONTEND_ORIGIN=http://localhost:3000

# JWT 配置
JWT_SECRET=change_me_for_local_demo
JWT_EXPIRES_IN=7d

# SQLite 数据库文件路径（相对于 server/ 目录）
DATABASE_PATH=data/zawer.db

# Zawer 本地演示配置
# 使用方式：
# 1. 复制本文件为 .env.local
# 2. 填写高德地图 Key/Secret
# 3. 启动前端和后端

# ------------------------
# 前端配置（Vite）
# ------------------------
VITE_API_BASE_URL=/api
VITE_AMAP_KEY=your_amap_key_here
VITE_AMAP_SECRET=your_amap_secret_here
VITE_APP_TITLE=Zawer - 本地演示

# ------------------------
# 后端配置（NestJS）
# ------------------------
SERVER_PORT=4000
FRONTEND_ORIGIN=http://localhost:3000
JWT_SECRET=change_me_for_local_demo
JWT_EXPIRES_IN=7d
DATABASE_PATH=data/zawer.db
